# Copy these keys into Render Dashboard → cleft-api → Environment
# Replace placeholders — never commit filled values to Git.
#
# Generate JWT secrets locally:
#   openssl rand -base64 48

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Set after Vercel deploy (Phase 3), then Manual Deploy backend again
FRONTEND_URL=https://YOUR_APP.vercel.app

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://YOUR_APP.vercel.app/api/auth/google/callback

JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-48

# Already set in render.yaml (listed here for reference):
# NODE_ENV=production
# COOKIE_SAME_SITE=none
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
