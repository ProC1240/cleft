DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleft?schema=public

BACKEND_PORT=4000
FRONTEND_PORT=3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

JWT_ACCESS_SECRET=replace-this-access-secret
JWT_REFRESH_SECRET=replace-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# เมื่อ deploy โดเมนแยก (Vercel + Render) backend ควรเป็น none — เปลี่ยนใน backend/.env บนโฮสต์นั้น
COOKIE_SAME_SITE=lax
